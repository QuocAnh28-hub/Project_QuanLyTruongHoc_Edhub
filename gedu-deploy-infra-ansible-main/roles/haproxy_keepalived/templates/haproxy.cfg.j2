global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user {{ haproxy_user }}
    group {{ haproxy_group }}
    daemon

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect 5000
    timeout client  50000
    timeout server  50000

# Kubernetes API Load Balancing
frontend {{ kube_api_frontend_name }}
    bind *:{{ kube_api_port }}
    mode tcp
    option tcplog
    default_backend {{ kube_api_backend_name }}

backend {{ kube_api_backend_name }}
    mode tcp
    option tcp-check
    balance roundrobin
    option httpchk GET /healthz
    http-check expect status 200
{% for master in groups['masters'] %}
    server {{ master }} {{ hostvars[master]['ansible_host'] }}:{{ kube_api_port }} check
{% endfor %}

# Istio Ingress Gateway Load Balancing (HTTPS)
{% if haproxy_ssl_mode == "tcp" %}
# SSL Passthrough Mode - TCP forwarding to Istio for SSL termination
frontend {{ istio_ingress_https_frontend_name }}
    bind *:{{ istio_ingress_https_port }}
    mode tcp
    option tcplog
    default_backend {{ istio_ingress_https_backend_name }}

backend {{ istio_ingress_https_backend_name }}
    mode tcp
    balance roundrobin
    option tcp-check
{% for worker in groups['workers'] %}
    server {{ worker }} {{ hostvars[worker]['ansible_host'] }}:{{ istio_ingress_https_nodeport }} check
{% endfor %}

{% else %}
# SSL Termination Mode - HAProxy handles SSL termination
frontend {{ istio_ingress_https_frontend_name }}
    bind *:{{ istio_ingress_https_port }} ssl crt {{ ssl_cert_path }}
    mode http
    option httplog
    option forwardfor
    option http-server-close
    default_backend {{ istio_ingress_https_backend_name }}

backend {{ istio_ingress_https_backend_name }}
    mode http
    balance roundrobin
    option forwardfor
    option http-server-close
{% for worker in groups['workers'] %}
    server {{ worker }} {{ hostvars[worker]['ansible_host'] }}:{{ istio_ingress_nodeport }} check
{% endfor %}
{% endif %}

# HTTP to HTTPS Redirect
frontend http-redirect
    bind *:{{ istio_ingress_port }}
    mode http
    option httplog
    option forwardfor
    option http-server-close
    redirect scheme https code 301 if !{ ssl_fc }

# Istio Ingress Gateway Load Balancing (HTTP - for internal traffic)
frontend {{ istio_ingress_frontend_name }}
    bind *:{{ istio_ingress_internal_port }}
    mode http
    option httplog
    option forwardfor
    option http-server-close
    default_backend {{ istio_ingress_backend_name }}

backend {{ istio_ingress_backend_name }}
    mode http
    balance roundrobin
    option httpchk GET /healthz/ready
    http-check expect status 200
    option forwardfor
    option http-server-close
{% for worker in groups['workers'] %}
    server {{ worker }} {{ hostvars[worker]['ansible_host'] }}:{{ istio_ingress_healthcheck_nodeport }} check
{% endfor %} 