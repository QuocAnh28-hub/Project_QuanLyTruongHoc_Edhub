[Unit]
Description=GitHub Self-Hosted Runner
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User={{ github_runner_container_user }}
Group={{ github_runner_container_user }}
WorkingDirectory=/home/{{ github_runner_container_user }}/actions-runner
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target