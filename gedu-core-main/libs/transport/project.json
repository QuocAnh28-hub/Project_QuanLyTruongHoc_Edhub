{
  "name": "transport",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/transport/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/transport",
        "main": "libs/transport/src/index.ts",
        "tsConfig": "libs/transport/tsconfig.lib.json",
        "assets": [
          {
            "glob": "**/*.proto",
            "input": "libs/transport/src/grpc/protos",
            "output": "../../assets/protos"
          }
        ]
      },
      "dependsOn": [
        {
          "target": "build",
          "dependencies": true
        }
      ]
    }
  }
} 