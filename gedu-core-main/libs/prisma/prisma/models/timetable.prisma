model TimetablePeriod {
  id        Int     @id @default(autoincrement())
  orgId     Int     @map("org_id")
  period    Int // Period 1 - 10
  shift     Int     @default(1) // 1=Morning, 2=Afternoon
  startTime String  @map("start_time") // e.g. "07:30"
  endTime   String  @map("end_time") // e.g. "08:15"
  isActive  Boolean @default(true) @map("is_active")

  school School @relation(fields: [orgId], references: [id])

  @@unique([orgId, period, shift])
  @@map("timetable_periods")
}

model TimetableSchedule {
  id           Int      @id @default(autoincrement())
  orgId        Int      @map("org_id")
  classId      Int      @map("class_id")
  subjectId    Int      @map("subject_id")
  teacherId    Int?     @map("teacher_id")
  schoolYearId Int      @map("school_year_id")
  semesterId   Int?     @map("semester_id")
  dayOfWeek    Int      @map("day_of_week") // 2 = Monday, ..., 8 = Sunday
  period       Int // Period 1 - 10
  roomNumber   String?  @map("room_number")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  school     School       @relation(fields: [orgId], references: [id])
  class      Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject    Subject      @relation(fields: [subjectId], references: [id])
  teacher    SchoolStaff? @relation(fields: [teacherId], references: [id])
  schoolYear SchoolYear   @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  semester   Semester?    @relation(fields: [semesterId], references: [id], onDelete: SetNull)

  @@unique([classId, schoolYearId, semesterId, dayOfWeek, period])
  @@index([orgId, classId])
  @@index([teacherId, dayOfWeek, period])
  @@map("timetable_schedules")
}
