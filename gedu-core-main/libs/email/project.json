{
  "name": "email",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/email/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/email",
        "main": "libs/email/src/index.ts",
        "tsConfig": "libs/email/tsconfig.lib.json"
      },
      "dependsOn": [
        {
          "target": "build",
          "dependencies": true
        }
      ]
    }
  }
} 