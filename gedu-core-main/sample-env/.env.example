# This file contains environment variables that are shared across all services.
# These can be overridden by service-specific .env files.
NETWORK_NAME=gedu-network

DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=demo

DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=eduhub

# Province
PROVINCE_ID=

# Kafka
KAFKA_BROKERS=

# Redis
REDIS_URL=

# Log
LOG_LEVEL=

# Minio
MINIO_ENDPOINT=static.lazeout.com
MINIO_PORT=443
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# gRPC Import
GRPC_IMPORT_HOST=
GRPC_IMPORT_PORT=50001