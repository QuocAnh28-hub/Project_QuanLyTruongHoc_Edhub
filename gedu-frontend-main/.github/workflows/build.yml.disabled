name: Build and Deploy Docker Image

on:
  push:
    branches:
      - dev
  pull_request:
    branches:
      - dev

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/dev' && github.event_name == 'push'
    environment: development

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build Docker image
        uses: docker/build-push-action@v5
        with:
          context: .
          file: ./Dockerfile
          push: false
          load: true
          tags: gedu-frontend:latest
          build-args: |
            VITE_API_ENDPOINT=${{ vars.API_PATH }}

      - name: Save Docker image
        run: docker save gedu-frontend:latest | gzip > gedu-frontend.tar.gz

      - name: Upload Docker image artifact
        uses: actions/upload-artifact@v4
        with:
          name: gedu-frontend-image
          path: gedu-frontend.tar.gz
          retention-days: 7

  deploy:
    needs: build-and-deploy
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/dev' && github.event_name == 'push'
    environment: development

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Download Docker image artifact
        uses: actions/download-artifact@v4
        with:
          name: gedu-frontend-image
          path: .

      - name: Prepare deployment directory on server
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.SERVER_HOST }}
          username: ${{ secrets.SERVER_USER }}
          key: ${{ secrets.SERVER_SSH_PRIVATE_KEY }}
          port: 22
          script: |
            # Stop and remove existing container if it exists
            docker stop gedu-frontend || true
            docker rm gedu-frontend || true
            
            # Remove existing image if it exists
            docker rmi gedu-frontend:latest || true
            
            # Create app directory if it doesn't exist
            mkdir -p ${{ vars.APP_IMAGE_DIR }}

      - name: Upload Docker image to server
        uses: appleboy/scp-action@v0.1.7
        with:
          host: ${{ secrets.SERVER_HOST }}
          username: ${{ secrets.SERVER_USER }}
          key: ${{ secrets.SERVER_SSH_PRIVATE_KEY }}
          port: 22
          source: "gedu-frontend.tar.gz"
          target: ${{ vars.APP_IMAGE_DIR }}
          timeout: 300s

      - name: Upload deployment script to server
        uses: appleboy/scp-action@v0.1.7
        with:
          host: ${{ secrets.SERVER_HOST }}
          username: ${{ secrets.SERVER_USER }}
          key: ${{ secrets.SERVER_SSH_PRIVATE_KEY }}
          port: 22
          source: "deploy.sh"
          target: ${{ vars.APP_IMAGE_DIR }}
          timeout: 60s

      - name: Load and run Docker image on server
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.SERVER_HOST }}
          username: ${{ secrets.SERVER_USER }}
          key: ${{ secrets.SERVER_SSH_PRIVATE_KEY }}
          port: 22
          script: |
            cd ${{ vars.APP_IMAGE_DIR }}
            
            # Make deploy script executable
            chmod +x deploy.sh
            
            # Load the Docker image
            echo "📥 Loading Docker image..."
            gunzip -c gedu-frontend.tar.gz | docker load
            
            # Update and start the container
            echo "🚀 Starting container..."
            ./deploy.sh update
            
            # Wait a moment for container to start
            sleep 10
            
            # Check if container is running
            if docker ps | grep -q gedu-frontend; then
              echo "✅ Container started successfully"
              echo "🌐 Application available at http://${{ secrets.SERVER_HOST }}:5001"
              
              # Health check
              echo "🏥 Performing health check..."
              sleep 5
              if curl -f http://localhost:5001/health > /dev/null 2>&1; then
                echo "✅ Health check passed"
              else
                echo "⚠️ Health check failed, but container is running"
              fi
            else
              echo "❌ Container failed to start"
              echo "📋 Container logs:"
              ./deploy.sh logs
              exit 1
            fi